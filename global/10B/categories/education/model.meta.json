{
  "id": "global.10B.categories.education",
  "name": "World — Education and learning",
  "kind": "sector_economic",
  "blurb": "World rollup for **education and learning** across 257 countries — the cross-country slice of the 10B model along the education dimension.",
  "mechanism": "Aggregates the per-country education models into a population-weighted world mean, a country-level ranking with confidence intervals, and a macro-space embedding feeding the unsupervised dynamics model.\n\nThis is the supervised trajectory's primary anchor for the education dimension: holdout datasets of sociodemographic characteristics are predicted via the per-country models and validated against the world mean and ranking produced here.",
  "components": [
    {
      "id": "aggregator",
      "name": "Education and learning world aggregator",
      "role": "Aggregates per-country category scores by population-weighted mean.",
      "crate_path": null,
      "key_symbols": [
        "population_weighted_mean"
      ]
    },
    {
      "id": "ranker",
      "name": "Education and learning country ranker",
      "role": "Ranks countries by category satisfaction with confidence intervals.",
      "crate_path": null,
      "key_symbols": [
        "rank_with_ci"
      ]
    },
    {
      "id": "macro-embedder",
      "name": "Education and learning macro-embedder",
      "role": "Produces a 16-dim global category embedding for the unsupervised macro-space.",
      "crate_path": null,
      "key_symbols": [
        "embed_macro"
      ]
    }
  ],
  "inputs": [
    {
      "name": "education-country-scores",
      "kind": "scalar-list",
      "description": "Per-country satisfaction scores for education and learning."
    }
  ],
  "outputs": [
    {
      "name": "education-world-mean",
      "kind": "scalar",
      "description": "Population-weighted world mean for education and learning."
    },
    {
      "name": "education-country-ranking",
      "kind": "ranking",
      "description": "Country-level ranking on education and learning."
    },
    {
      "name": "education-macro-embedding",
      "kind": "embedding",
      "description": "Education and learning contribution to the global 10B macro-space embedding."
    }
  ],
  "parameters": [
    {
      "key": "category",
      "value": "Education and learning"
    },
    {
      "key": "countries-covered",
      "value": "257"
    },
    {
      "key": "frameworks",
      "value": "MaxNeef:understanding, DoyalGough:autonomy, SDG-4",
      "description": "Theoretical frameworks the category draws from."
    }
  ],
  "references": [
    {
      "label": "10B Needs Tree",
      "kind": "spec",
      "location": "global/10B/needs-tree.json"
    }
  ],
