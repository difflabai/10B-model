{
  "id": "global.10B.categories.governance",
  "name": "World — Governance and rule of law",
  "kind": "sector_economic",
  "blurb": "World rollup for **governance and rule of law** across 257 countries — the cross-country slice of the 10B model along the governance dimension.",
  "mechanism": "Aggregates the per-country governance models into a population-weighted world mean, a country-level ranking with confidence intervals, and a macro-space embedding feeding the unsupervised dynamics model.\n\nThis is the supervised trajectory's primary anchor for the governance dimension: holdout datasets of sociodemographic characteristics are predicted via the per-country models and validated against the world mean and ranking produced here.",
  "components": [
    {
      "id": "aggregator",
      "name": "Governance and rule of law world aggregator",
      "role": "Aggregates per-country category scores by population-weighted mean.",
      "crate_path": null,
      "key_symbols": [
        "population_weighted_mean"
      ]
    },
    {
      "id": "ranker",
      "name": "Governance and rule of law country ranker",
      "role": "Ranks countries by category satisfaction with confidence intervals.",
      "crate_path": null,
      "key_symbols": [
        "rank_with_ci"
      ]
    },
    {
      "id": "macro-embedder",
      "name": "Governance and rule of law macro-embedder",
      "role": "Produces a 16-dim global category embedding for the unsupervised macro-space.",
      "crate_path": null,
      "key_symbols": [
        "embed_macro"
      ]
    }
  ],
  "inputs": [
    {
      "name": "governance-country-scores",
      "kind": "scalar-list",
      "description": "Per-country satisfaction scores for governance and rule of law."
    }
  ],
  "outputs": [
    {
      "name": "governance-world-mean",
      "kind": "scalar",
      "description": "Population-weighted world mean for governance and rule of law."
    },
    {
      "name": "governance-country-ranking",
      "kind": "ranking",
      "description": "Country-level ranking on governance and rule of law."
    },
    {
      "name": "governance-macro-embedding",
      "kind": "embedding",
      "description": "Governance and rule of law contribution to the global 10B macro-space embedding."
    }
  ],
  "parameters": [
    {
      "key": "category",
      "value": "Governance and rule of law"
    },
    {
      "key": "countries-covered",
      "value": "257"
    },
    {
      "key": "frameworks",
      "value": "MaxNeef:protection, DoyalGough:autonomy, SDG-16",
      "description": "Theoretical frameworks the category draws from."
    }
  ],
  "references": [
    {
      "label": "10B Needs Tree",
      "kind": "spec",
      "location": "global/10B/needs-tree.json"
    }
  ],
