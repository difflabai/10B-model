{
  "id": "global.10B.categories.belonging",
  "name": "World — Belonging and social cohesion",
  "kind": "sector_economic",
  "blurb": "World rollup for **belonging and social cohesion** across 257 countries — the cross-country slice of the 10B model along the belonging dimension.",
  "mechanism": "Aggregates the per-country belonging models into a population-weighted world mean, a country-level ranking with confidence intervals, and a macro-space embedding feeding the unsupervised dynamics model.\n\nThis is the supervised trajectory's primary anchor for the belonging dimension: holdout datasets of sociodemographic characteristics are predicted via the per-country models and validated against the world mean and ranking produced here.",
  "components": [
    {
      "id": "aggregator",
      "name": "Belonging and social cohesion world aggregator",
      "role": "Aggregates per-country category scores by population-weighted mean.",
      "crate_path": null,
      "key_symbols": [
        "population_weighted_mean"
      ]
    },
    {
      "id": "ranker",
      "name": "Belonging and social cohesion country ranker",
      "role": "Ranks countries by category satisfaction with confidence intervals.",
      "crate_path": null,
      "key_symbols": [
        "rank_with_ci"
      ]
    },
    {
      "id": "macro-embedder",
      "name": "Belonging and social cohesion macro-embedder",
      "role": "Produces a 16-dim global category embedding for the unsupervised macro-space.",
      "crate_path": null,
      "key_symbols": [
        "embed_macro"
      ]
    }
  ],
  "inputs": [
    {
      "name": "belonging-country-scores",
      "kind": "scalar-list",
      "description": "Per-country satisfaction scores for belonging and social cohesion."
    }
  ],
  "outputs": [
    {
      "name": "belonging-world-mean",
      "kind": "scalar",
      "description": "Population-weighted world mean for belonging and social cohesion."
    },
    {
      "name": "belonging-country-ranking",
      "kind": "ranking",
      "description": "Country-level ranking on belonging and social cohesion."
    },
    {
      "name": "belonging-macro-embedding",
      "kind": "embedding",
      "description": "Belonging and social cohesion contribution to the global 10B macro-space embedding."
    }
  ],
  "parameters": [
    {
      "key": "category",
      "value": "Belonging and social cohesion"
    },
    {
      "key": "countries-covered",
      "value": "257"
    },
    {
      "key": "frameworks",
      "value": "Maslow:belonging, MaxNeef:affection, SDG-10",
      "description": "Theoretical frameworks the category draws from."
    }
  ],
  "references": [
    {
      "label": "10B Needs Tree",
      "kind": "spec",
      "location": "global/10B/needs-tree.json"
    }
  ],
