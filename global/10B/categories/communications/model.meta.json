{
  "id": "global.10B.categories.communications",
  "name": "World — Communications and connectivity",
  "kind": "sector_economic",
  "blurb": "World rollup for **communications and connectivity** across 257 countries — the cross-country slice of the 10B model along the communications dimension.",
  "mechanism": "Aggregates the per-country communications models into a population-weighted world mean, a country-level ranking with confidence intervals, and a macro-space embedding feeding the unsupervised dynamics model.\n\nThis is the supervised trajectory's primary anchor for the communications dimension: holdout datasets of sociodemographic characteristics are predicted via the per-country models and validated against the world mean and ranking produced here.",
  "components": [
    {
      "id": "aggregator",
      "name": "Communications and connectivity world aggregator",
      "role": "Aggregates per-country category scores by population-weighted mean.",
      "crate_path": null,
      "key_symbols": [
        "population_weighted_mean"
      ]
    },
    {
      "id": "ranker",
      "name": "Communications and connectivity country ranker",
      "role": "Ranks countries by category satisfaction with confidence intervals.",
      "crate_path": null,
      "key_symbols": [
        "rank_with_ci"
      ]
    },
    {
      "id": "macro-embedder",
      "name": "Communications and connectivity macro-embedder",
      "role": "Produces a 16-dim global category embedding for the unsupervised macro-space.",
      "crate_path": null,
      "key_symbols": [
        "embed_macro"
      ]
    }
  ],
  "inputs": [
    {
      "name": "communications-country-scores",
      "kind": "scalar-list",
      "description": "Per-country satisfaction scores for communications and connectivity."
    }
  ],
  "outputs": [
    {
      "name": "communications-world-mean",
      "kind": "scalar",
      "description": "Population-weighted world mean for communications and connectivity."
    },
    {
      "name": "communications-country-ranking",
      "kind": "ranking",
      "description": "Country-level ranking on communications and connectivity."
    },
    {
      "name": "communications-macro-embedding",
      "kind": "embedding",
      "description": "Communications and connectivity contribution to the global 10B macro-space embedding."
    }
  ],
  "parameters": [
    {
      "key": "category",
      "value": "Communications and connectivity"
    },
    {
      "key": "countries-covered",
      "value": "257"
    },
    {
      "key": "frameworks",
      "value": "MaxNeef:participation, SDG-9",
      "description": "Theoretical frameworks the category draws from."
    }
  ],
  "references": [
    {
      "label": "10B Needs Tree",
      "kind": "spec",
      "location": "global/10B/needs-tree.json"
    }
  ],
