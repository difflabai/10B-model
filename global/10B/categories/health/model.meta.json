{
  "id": "global.10B.categories.health",
  "name": "World — Health and longevity",
  "kind": "sector_economic",
  "blurb": "World rollup for **health and longevity** across 257 countries — the cross-country slice of the 10B model along the health dimension.",
  "mechanism": "Aggregates the per-country health models into a population-weighted world mean, a country-level ranking with confidence intervals, and a macro-space embedding feeding the unsupervised dynamics model.\n\nThis is the supervised trajectory's primary anchor for the health dimension: holdout datasets of sociodemographic characteristics are predicted via the per-country models and validated against the world mean and ranking produced here.",
  "components": [
    {
      "id": "aggregator",
      "name": "Health and longevity world aggregator",
      "role": "Aggregates per-country category scores by population-weighted mean.",
      "crate_path": null,
      "key_symbols": [
        "population_weighted_mean"
      ]
    },
    {
      "id": "ranker",
      "name": "Health and longevity country ranker",
      "role": "Ranks countries by category satisfaction with confidence intervals.",
      "crate_path": null,
      "key_symbols": [
        "rank_with_ci"
      ]
    },
    {
      "id": "macro-embedder",
      "name": "Health and longevity macro-embedder",
      "role": "Produces a 16-dim global category embedding for the unsupervised macro-space.",
      "crate_path": null,
      "key_symbols": [
        "embed_macro"
      ]
    }
  ],
  "inputs": [
    {
      "name": "health-country-scores",
      "kind": "scalar-list",
      "description": "Per-country satisfaction scores for health and longevity."
    }
  ],
  "outputs": [
    {
      "name": "health-world-mean",
      "kind": "scalar",
      "description": "Population-weighted world mean for health and longevity."
    },
    {
      "name": "health-country-ranking",
      "kind": "ranking",
      "description": "Country-level ranking on health and longevity."
    },
    {
      "name": "health-macro-embedding",
      "kind": "embedding",
      "description": "Health and longevity contribution to the global 10B macro-space embedding."
    }
  ],
  "parameters": [
    {
      "key": "category",
      "value": "Health and longevity"
    },
    {
      "key": "countries-covered",
      "value": "257"
    },
    {
      "key": "frameworks",
      "value": "Maslow:physiological, MaxNeef:subsistence, DoyalGough:health, SDG-3",
      "description": "Theoretical frameworks the category draws from."
    }
  ],
  "references": [
    {
      "label": "10B Needs Tree",
      "kind": "spec",
      "location": "global/10B/needs-tree.json"
    }
  ],
