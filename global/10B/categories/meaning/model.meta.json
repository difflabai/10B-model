{
  "id": "global.10B.categories.meaning",
  "name": "World — Meaning, identity, and culture",
  "kind": "sector_economic",
  "blurb": "World rollup for **meaning, identity, and culture** across 257 countries — the cross-country slice of the 10B model along the meaning dimension.",
  "mechanism": "Aggregates the per-country meaning models into a population-weighted world mean, a country-level ranking with confidence intervals, and a macro-space embedding feeding the unsupervised dynamics model.\n\nThis is the supervised trajectory's primary anchor for the meaning dimension: holdout datasets of sociodemographic characteristics are predicted via the per-country models and validated against the world mean and ranking produced here.",
  "components": [
    {
      "id": "aggregator",
      "name": "Meaning, identity, and culture world aggregator",
      "role": "Aggregates per-country category scores by population-weighted mean.",
      "crate_path": null,
      "key_symbols": [
        "population_weighted_mean"
      ]
    },
    {
      "id": "ranker",
      "name": "Meaning, identity, and culture country ranker",
      "role": "Ranks countries by category satisfaction with confidence intervals.",
      "crate_path": null,
      "key_symbols": [
        "rank_with_ci"
      ]
    },
    {
      "id": "macro-embedder",
      "name": "Meaning, identity, and culture macro-embedder",
      "role": "Produces a 16-dim global category embedding for the unsupervised macro-space.",
      "crate_path": null,
      "key_symbols": [
        "embed_macro"
      ]
    }
  ],
  "inputs": [
    {
      "name": "meaning-country-scores",
      "kind": "scalar-list",
      "description": "Per-country satisfaction scores for meaning, identity, and culture."
    }
  ],
  "outputs": [
    {
      "name": "meaning-world-mean",
      "kind": "scalar",
      "description": "Population-weighted world mean for meaning, identity, and culture."
    },
    {
      "name": "meaning-country-ranking",
      "kind": "ranking",
      "description": "Country-level ranking on meaning, identity, and culture."
    },
    {
      "name": "meaning-macro-embedding",
      "kind": "embedding",
      "description": "Meaning, identity, and culture contribution to the global 10B macro-space embedding."
    }
  ],
  "parameters": [
    {
      "key": "category",
      "value": "Meaning, identity, and culture"
    },
    {
      "key": "countries-covered",
      "value": "257"
    },
    {
      "key": "frameworks",
      "value": "Maslow:self-actualization, MaxNeef:identity, SDG-4.7",
      "description": "Theoretical frameworks the category draws from."
    }
  ],
  "references": [
    {
      "label": "10B Needs Tree",
      "kind": "spec",
      "location": "global/10B/needs-tree.json"
    }
  ],
