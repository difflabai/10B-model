{
  "id": "global.10B.categories.energy",
  "name": "World — Energy access",
  "kind": "sector_economic",
  "blurb": "World rollup for **energy access** across 257 countries — the cross-country slice of the 10B model along the energy dimension.",
  "mechanism": "Aggregates the per-country energy models into a population-weighted world mean, a country-level ranking with confidence intervals, and a macro-space embedding feeding the unsupervised dynamics model.\n\nThis is the supervised trajectory's primary anchor for the energy dimension: holdout datasets of sociodemographic characteristics are predicted via the per-country models and validated against the world mean and ranking produced here.",
  "components": [
    {
      "id": "aggregator",
      "name": "Energy access world aggregator",
      "role": "Aggregates per-country category scores by population-weighted mean.",
      "crate_path": null,
      "key_symbols": [
        "population_weighted_mean"
      ]
    },
    {
      "id": "ranker",
      "name": "Energy access country ranker",
      "role": "Ranks countries by category satisfaction with confidence intervals.",
      "crate_path": null,
      "key_symbols": [
        "rank_with_ci"
      ]
    },
    {
      "id": "macro-embedder",
      "name": "Energy access macro-embedder",
      "role": "Produces a 16-dim global category embedding for the unsupervised macro-space.",
      "crate_path": null,
      "key_symbols": [
        "embed_macro"
      ]
    }
  ],
  "inputs": [
    {
      "name": "energy-country-scores",
      "kind": "scalar-list",
      "description": "Per-country satisfaction scores for energy access."
    }
  ],
  "outputs": [
    {
      "name": "energy-world-mean",
      "kind": "scalar",
      "description": "Population-weighted world mean for energy access."
    },
    {
      "name": "energy-country-ranking",
      "kind": "ranking",
      "description": "Country-level ranking on energy access."
    },
    {
      "name": "energy-macro-embedding",
      "kind": "embedding",
      "description": "Energy access contribution to the global 10B macro-space embedding."
    }
  ],
  "parameters": [
    {
      "key": "category",
      "value": "Energy access"
    },
    {
      "key": "countries-covered",
      "value": "257"
    },
    {
      "key": "frameworks",
      "value": "MaxNeef:subsistence, SDG-7",
      "description": "Theoretical frameworks the category draws from."
    }
  ],
  "references": [
    {
      "label": "10B Needs Tree",
      "kind": "spec",
      "location": "global/10B/needs-tree.json"
    }
  ],
