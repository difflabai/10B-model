{
  "id": "global.10B.categories.shelter",
  "name": "World — Shelter and habitat",
  "kind": "sector_economic",
  "blurb": "World rollup for **shelter and habitat** across 257 countries — the cross-country slice of the 10B model along the shelter dimension.",
  "mechanism": "Aggregates the per-country shelter models into a population-weighted world mean, a country-level ranking with confidence intervals, and a macro-space embedding feeding the unsupervised dynamics model.\n\nThis is the supervised trajectory's primary anchor for the shelter dimension: holdout datasets of sociodemographic characteristics are predicted via the per-country models and validated against the world mean and ranking produced here.",
  "components": [
    {
      "id": "aggregator",
      "name": "Shelter and habitat world aggregator",
      "role": "Aggregates per-country category scores by population-weighted mean.",
      "crate_path": null,
      "key_symbols": [
        "population_weighted_mean"
      ]
    },
    {
      "id": "ranker",
      "name": "Shelter and habitat country ranker",
      "role": "Ranks countries by category satisfaction with confidence intervals.",
      "crate_path": null,
      "key_symbols": [
        "rank_with_ci"
      ]
    },
    {
      "id": "macro-embedder",
      "name": "Shelter and habitat macro-embedder",
      "role": "Produces a 16-dim global category embedding for the unsupervised macro-space.",
      "crate_path": null,
      "key_symbols": [
        "embed_macro"
      ]
    }
  ],
  "inputs": [
    {
      "name": "shelter-country-scores",
      "kind": "scalar-list",
      "description": "Per-country satisfaction scores for shelter and habitat."
    }
  ],
  "outputs": [
    {
      "name": "shelter-world-mean",
      "kind": "scalar",
      "description": "Population-weighted world mean for shelter and habitat."
    },
    {
      "name": "shelter-country-ranking",
      "kind": "ranking",
      "description": "Country-level ranking on shelter and habitat."
    },
    {
      "name": "shelter-macro-embedding",
      "kind": "embedding",
      "description": "Shelter and habitat contribution to the global 10B macro-space embedding."
    }
  ],
  "parameters": [
    {
      "key": "category",
      "value": "Shelter and habitat"
    },
    {
      "key": "countries-covered",
      "value": "257"
    },
    {
      "key": "frameworks",
      "value": "Maslow:physiological, MaxNeef:protection, SDG-11",
      "description": "Theoretical frameworks the category draws from."
    }
  ],
  "references": [
    {
      "label": "10B Needs Tree",
      "kind": "spec",
      "location": "global/10B/needs-tree.json"
    }
  ],
