{
  "id": "global.10B.categories.safety",
  "name": "World — Safety and protection from violence",
  "kind": "sector_economic",
  "blurb": "World rollup for **safety and protection from violence** across 257 countries — the cross-country slice of the 10B model along the safety dimension.",
  "mechanism": "Aggregates the per-country safety models into a population-weighted world mean, a country-level ranking with confidence intervals, and a macro-space embedding feeding the unsupervised dynamics model.\n\nThis is the supervised trajectory's primary anchor for the safety dimension: holdout datasets of sociodemographic characteristics are predicted via the per-country models and validated against the world mean and ranking produced here.",
  "components": [
    {
      "id": "aggregator",
      "name": "Safety and protection from violence world aggregator",
      "role": "Aggregates per-country category scores by population-weighted mean.",
      "crate_path": null,
      "key_symbols": [
        "population_weighted_mean"
      ]
    },
    {
      "id": "ranker",
      "name": "Safety and protection from violence country ranker",
      "role": "Ranks countries by category satisfaction with confidence intervals.",
      "crate_path": null,
      "key_symbols": [
        "rank_with_ci"
      ]
    },
    {
      "id": "macro-embedder",
      "name": "Safety and protection from violence macro-embedder",
      "role": "Produces a 16-dim global category embedding for the unsupervised macro-space.",
      "crate_path": null,
      "key_symbols": [
        "embed_macro"
      ]
    }
  ],
  "inputs": [
    {
      "name": "safety-country-scores",
      "kind": "scalar-list",
      "description": "Per-country satisfaction scores for safety and protection from violence."
    }
  ],
  "outputs": [
    {
      "name": "safety-world-mean",
      "kind": "scalar",
      "description": "Population-weighted world mean for safety and protection from violence."
    },
    {
      "name": "safety-country-ranking",
      "kind": "ranking",
      "description": "Country-level ranking on safety and protection from violence."
    },
    {
      "name": "safety-macro-embedding",
      "kind": "embedding",
      "description": "Safety and protection from violence contribution to the global 10B macro-space embedding."
    }
  ],
  "parameters": [
    {
      "key": "category",
      "value": "Safety and protection from violence"
    },
    {
      "key": "countries-covered",
      "value": "257"
    },
    {
      "key": "frameworks",
      "value": "Maslow:safety, MaxNeef:protection, DoyalGough:security, SDG-16",
      "description": "Theoretical frameworks the category draws from."
    }
  ],
  "references": [
    {
      "label": "10B Needs Tree",
      "kind": "spec",
      "location": "global/10B/needs-tree.json"
    }
  ],
