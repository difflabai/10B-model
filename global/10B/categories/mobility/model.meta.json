{
  "id": "global.10B.categories.mobility",
  "name": "World — Mobility and transportation",
  "kind": "sector_economic",
  "blurb": "World rollup for **mobility and transportation** across 257 countries — the cross-country slice of the 10B model along the mobility dimension.",
  "mechanism": "Aggregates the per-country mobility models into a population-weighted world mean, a country-level ranking with confidence intervals, and a macro-space embedding feeding the unsupervised dynamics model.\n\nThis is the supervised trajectory's primary anchor for the mobility dimension: holdout datasets of sociodemographic characteristics are predicted via the per-country models and validated against the world mean and ranking produced here.",
  "components": [
    {
      "id": "aggregator",
      "name": "Mobility and transportation world aggregator",
      "role": "Aggregates per-country category scores by population-weighted mean.",
      "crate_path": null,
      "key_symbols": [
        "population_weighted_mean"
      ]
    },
    {
      "id": "ranker",
      "name": "Mobility and transportation country ranker",
      "role": "Ranks countries by category satisfaction with confidence intervals.",
      "crate_path": null,
      "key_symbols": [
        "rank_with_ci"
      ]
    },
    {
      "id": "macro-embedder",
      "name": "Mobility and transportation macro-embedder",
      "role": "Produces a 16-dim global category embedding for the unsupervised macro-space.",
      "crate_path": null,
      "key_symbols": [
        "embed_macro"
      ]
    }
  ],
  "inputs": [
    {
      "name": "mobility-country-scores",
      "kind": "scalar-list",
      "description": "Per-country satisfaction scores for mobility and transportation."
    }
  ],
  "outputs": [
    {
      "name": "mobility-world-mean",
      "kind": "scalar",
      "description": "Population-weighted world mean for mobility and transportation."
    },
    {
      "name": "mobility-country-ranking",
      "kind": "ranking",
      "description": "Country-level ranking on mobility and transportation."
    },
    {
      "name": "mobility-macro-embedding",
      "kind": "embedding",
      "description": "Mobility and transportation contribution to the global 10B macro-space embedding."
    }
  ],
  "parameters": [
    {
      "key": "category",
      "value": "Mobility and transportation"
    },
    {
      "key": "countries-covered",
      "value": "257"
    },
    {
      "key": "frameworks",
      "value": "MaxNeef:participation, SDG-9",
      "description": "Theoretical frameworks the category draws from."
    }
  ],
  "references": [
    {
      "label": "10B Needs Tree",
      "kind": "spec",
      "location": "global/10B/needs-tree.json"
    }
  ],
