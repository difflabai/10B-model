{
  "id": "global.10B.categories.food",
  "name": "World — Food and nutrition",
  "kind": "sector_economic",
  "blurb": "World rollup for **food and nutrition** across 257 countries — the cross-country slice of the 10B model along the food dimension.",
  "mechanism": "Aggregates the per-country food models into a population-weighted world mean, a country-level ranking with confidence intervals, and a macro-space embedding feeding the unsupervised dynamics model.\n\nThis is the supervised trajectory's primary anchor for the food dimension: holdout datasets of sociodemographic characteristics are predicted via the per-country models and validated against the world mean and ranking produced here.",
  "components": [
    {
      "id": "aggregator",
      "name": "Food and nutrition world aggregator",
      "role": "Aggregates per-country category scores by population-weighted mean.",
      "crate_path": null,
      "key_symbols": [
        "population_weighted_mean"
      ]
    },
    {
      "id": "ranker",
      "name": "Food and nutrition country ranker",
      "role": "Ranks countries by category satisfaction with confidence intervals.",
      "crate_path": null,
      "key_symbols": [
        "rank_with_ci"
      ]
    },
    {
      "id": "macro-embedder",
      "name": "Food and nutrition macro-embedder",
      "role": "Produces a 16-dim global category embedding for the unsupervised macro-space.",
      "crate_path": null,
      "key_symbols": [
        "embed_macro"
      ]
    }
  ],
  "inputs": [
    {
      "name": "food-country-scores",
      "kind": "scalar-list",
      "description": "Per-country satisfaction scores for food and nutrition."
    }
  ],
  "outputs": [
    {
      "name": "food-world-mean",
      "kind": "scalar",
      "description": "Population-weighted world mean for food and nutrition."
    },
    {
      "name": "food-country-ranking",
      "kind": "ranking",
      "description": "Country-level ranking on food and nutrition."
    },
    {
      "name": "food-macro-embedding",
      "kind": "embedding",
      "description": "Food and nutrition contribution to the global 10B macro-space embedding."
    }
  ],
  "parameters": [
    {
      "key": "category",
      "value": "Food and nutrition"
    },
    {
      "key": "countries-covered",
      "value": "257"
    },
    {
      "key": "frameworks",
      "value": "Maslow:physiological, MaxNeef:subsistence, SDG-2",
      "description": "Theoretical frameworks the category draws from."
    }
  ],
  "references": [
    {
      "label": "10B Needs Tree",
      "kind": "spec",
      "location": "global/10B/needs-tree.json"
    }
  ],
