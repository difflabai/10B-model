{
  "id": "global.10B.categories.water",
  "name": "World — Water and sanitation",
  "kind": "sector_economic",
  "blurb": "World rollup for **water and sanitation** across 257 countries — the cross-country slice of the 10B model along the water dimension.",
  "mechanism": "Aggregates the per-country water models into a population-weighted world mean, a country-level ranking with confidence intervals, and a macro-space embedding feeding the unsupervised dynamics model.\n\nThis is the supervised trajectory's primary anchor for the water dimension: holdout datasets of sociodemographic characteristics are predicted via the per-country models and validated against the world mean and ranking produced here.",
  "components": [
    {
      "id": "aggregator",
      "name": "Water and sanitation world aggregator",
      "role": "Aggregates per-country category scores by population-weighted mean.",
      "crate_path": null,
      "key_symbols": [
        "population_weighted_mean"
      ]
    },
    {
      "id": "ranker",
      "name": "Water and sanitation country ranker",
      "role": "Ranks countries by category satisfaction with confidence intervals.",
      "crate_path": null,
      "key_symbols": [
        "rank_with_ci"
      ]
    },
    {
      "id": "macro-embedder",
      "name": "Water and sanitation macro-embedder",
      "role": "Produces a 16-dim global category embedding for the unsupervised macro-space.",
      "crate_path": null,
      "key_symbols": [
        "embed_macro"
      ]
    }
  ],
  "inputs": [
    {
      "name": "water-country-scores",
      "kind": "scalar-list",
      "description": "Per-country satisfaction scores for water and sanitation."
    }
  ],
  "outputs": [
    {
      "name": "water-world-mean",
      "kind": "scalar",
      "description": "Population-weighted world mean for water and sanitation."
    },
    {
      "name": "water-country-ranking",
      "kind": "ranking",
      "description": "Country-level ranking on water and sanitation."
    },
    {
      "name": "water-macro-embedding",
      "kind": "embedding",
      "description": "Water and sanitation contribution to the global 10B macro-space embedding."
    }
  ],
  "parameters": [
    {
      "key": "category",
      "value": "Water and sanitation"
    },
    {
      "key": "countries-covered",
      "value": "257"
    },
    {
      "key": "frameworks",
      "value": "Maslow:physiological, MaxNeef:subsistence, SDG-6",
      "description": "Theoretical frameworks the category draws from."
    }
  ],
  "references": [
    {
      "label": "10B Needs Tree",
      "kind": "spec",
      "location": "global/10B/needs-tree.json"
    }
  ],
