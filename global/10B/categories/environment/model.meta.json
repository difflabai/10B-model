{
  "id": "global.10B.categories.environment",
  "name": "World — Environmental sustainability",
  "kind": "sector_economic",
  "blurb": "World rollup for **environmental sustainability** across 257 countries — the cross-country slice of the 10B model along the environment dimension.",
  "mechanism": "Aggregates the per-country environment models into a population-weighted world mean, a country-level ranking with confidence intervals, and a macro-space embedding feeding the unsupervised dynamics model.\n\nThis is the supervised trajectory's primary anchor for the environment dimension: holdout datasets of sociodemographic characteristics are predicted via the per-country models and validated against the world mean and ranking produced here.",
  "components": [
    {
      "id": "aggregator",
      "name": "Environmental sustainability world aggregator",
      "role": "Aggregates per-country category scores by population-weighted mean.",
      "crate_path": null,
      "key_symbols": [
        "population_weighted_mean"
      ]
    },
    {
      "id": "ranker",
      "name": "Environmental sustainability country ranker",
      "role": "Ranks countries by category satisfaction with confidence intervals.",
      "crate_path": null,
      "key_symbols": [
        "rank_with_ci"
      ]
    },
    {
      "id": "macro-embedder",
      "name": "Environmental sustainability macro-embedder",
      "role": "Produces a 16-dim global category embedding for the unsupervised macro-space.",
      "crate_path": null,
      "key_symbols": [
        "embed_macro"
      ]
    }
  ],
  "inputs": [
    {
      "name": "environment-country-scores",
      "kind": "scalar-list",
      "description": "Per-country satisfaction scores for environmental sustainability."
    }
  ],
  "outputs": [
    {
      "name": "environment-world-mean",
      "kind": "scalar",
      "description": "Population-weighted world mean for environmental sustainability."
    },
    {
      "name": "environment-country-ranking",
      "kind": "ranking",
      "description": "Country-level ranking on environmental sustainability."
    },
    {
      "name": "environment-macro-embedding",
      "kind": "embedding",
      "description": "Environmental sustainability contribution to the global 10B macro-space embedding."
    }
  ],
  "parameters": [
    {
      "key": "category",
      "value": "Environmental sustainability"
    },
    {
      "key": "countries-covered",
      "value": "257"
    },
    {
      "key": "frameworks",
      "value": "MaxNeef:subsistence, SDG-13, SDG-15",
      "description": "Theoretical frameworks the category draws from."
    }
  ],
  "references": [
    {
      "label": "10B Needs Tree",
      "kind": "spec",
      "location": "global/10B/needs-tree.json"
    }
  ],
