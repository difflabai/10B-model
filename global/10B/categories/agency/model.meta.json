{
  "id": "global.10B.categories.agency",
  "name": "World — Agency and self-determination",
  "kind": "sector_economic",
  "blurb": "World rollup for **agency and self-determination** across 257 countries — the cross-country slice of the 10B model along the agency dimension.",
  "mechanism": "Aggregates the per-country agency models into a population-weighted world mean, a country-level ranking with confidence intervals, and a macro-space embedding feeding the unsupervised dynamics model.\n\nThis is the supervised trajectory's primary anchor for the agency dimension: holdout datasets of sociodemographic characteristics are predicted via the per-country models and validated against the world mean and ranking produced here.",
  "components": [
    {
      "id": "aggregator",
      "name": "Agency and self-determination world aggregator",
      "role": "Aggregates per-country category scores by population-weighted mean.",
      "crate_path": null,
      "key_symbols": [
        "population_weighted_mean"
      ]
    },
    {
      "id": "ranker",
      "name": "Agency and self-determination country ranker",
      "role": "Ranks countries by category satisfaction with confidence intervals.",
      "crate_path": null,
      "key_symbols": [
        "rank_with_ci"
      ]
    },
    {
      "id": "macro-embedder",
      "name": "Agency and self-determination macro-embedder",
      "role": "Produces a 16-dim global category embedding for the unsupervised macro-space.",
      "crate_path": null,
      "key_symbols": [
        "embed_macro"
      ]
    }
  ],
  "inputs": [
    {
      "name": "agency-country-scores",
      "kind": "scalar-list",
      "description": "Per-country satisfaction scores for agency and self-determination."
    }
  ],
  "outputs": [
    {
      "name": "agency-world-mean",
      "kind": "scalar",
      "description": "Population-weighted world mean for agency and self-determination."
    },
    {
      "name": "agency-country-ranking",
      "kind": "ranking",
      "description": "Country-level ranking on agency and self-determination."
    },
    {
      "name": "agency-macro-embedding",
      "kind": "embedding",
      "description": "Agency and self-determination contribution to the global 10B macro-space embedding."
    }
  ],
  "parameters": [
    {
      "key": "category",
      "value": "Agency and self-determination"
    },
    {
      "key": "countries-covered",
      "value": "257"
    },
    {
      "key": "frameworks",
      "value": "Maslow:esteem, MaxNeef:freedom, DoyalGough:autonomy, SDG-16",
      "description": "Theoretical frameworks the category draws from."
    }
  ],
  "references": [
    {
      "label": "10B Needs Tree",
      "kind": "spec",
      "location": "global/10B/needs-tree.json"
    }
  ],
