{
  "id": "global.10B.categories.work",
  "name": "World — Work and economic capability",
  "kind": "sector_economic",
  "blurb": "World rollup for **work and economic capability** across 257 countries — the cross-country slice of the 10B model along the work dimension.",
  "mechanism": "Aggregates the per-country work models into a population-weighted world mean, a country-level ranking with confidence intervals, and a macro-space embedding feeding the unsupervised dynamics model.\n\nThis is the supervised trajectory's primary anchor for the work dimension: holdout datasets of sociodemographic characteristics are predicted via the per-country models and validated against the world mean and ranking produced here.",
  "components": [
    {
      "id": "aggregator",
      "name": "Work and economic capability world aggregator",
      "role": "Aggregates per-country category scores by population-weighted mean.",
      "crate_path": null,
      "key_symbols": [
        "population_weighted_mean"
      ]
    },
    {
      "id": "ranker",
      "name": "Work and economic capability country ranker",
      "role": "Ranks countries by category satisfaction with confidence intervals.",
      "crate_path": null,
      "key_symbols": [
        "rank_with_ci"
      ]
    },
    {
      "id": "macro-embedder",
      "name": "Work and economic capability macro-embedder",
      "role": "Produces a 16-dim global category embedding for the unsupervised macro-space.",
      "crate_path": null,
      "key_symbols": [
        "embed_macro"
      ]
    }
  ],
  "inputs": [
    {
      "name": "work-country-scores",
      "kind": "scalar-list",
      "description": "Per-country satisfaction scores for work and economic capability."
    }
  ],
  "outputs": [
    {
      "name": "work-world-mean",
      "kind": "scalar",
      "description": "Population-weighted world mean for work and economic capability."
    },
    {
      "name": "work-country-ranking",
      "kind": "ranking",
      "description": "Country-level ranking on work and economic capability."
    },
    {
      "name": "work-macro-embedding",
      "kind": "embedding",
      "description": "Work and economic capability contribution to the global 10B macro-space embedding."
    }
  ],
  "parameters": [
    {
      "key": "category",
      "value": "Work and economic capability"
    },
    {
      "key": "countries-covered",
      "value": "257"
    },
    {
      "key": "frameworks",
      "value": "MaxNeef:creation, DoyalGough:economic-security, SDG-8",
      "description": "Theoretical frameworks the category draws from."
    }
  ],
  "references": [
    {
      "label": "10B Needs Tree",
      "kind": "spec",
      "location": "global/10B/needs-tree.json"
    }
  ],
