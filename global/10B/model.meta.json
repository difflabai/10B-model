{
  "id": "global.10B",
  "name": "10B — human-needs macro model",
  "kind": "forecast_harness",
  "blurb": "Top-level **10B** model — captures the human needs of every population on earth as a (257 countries × 15 categories) embedding, jointly trained on a supervised hold-out trajectory of sociodemographic characteristics and an unsupervised dynamics head that reveals attractors and transitions in the macro-space.",
  "mechanism": "Two converging trajectories meet at this model:\n\n**Top-down**: countries × categories × indicators from the CIA World Factbook and other public datasets. Each (country × category) pair is captured by a per-category model whose embedding feeds this rollup.\n\n**Bottom-up**: simulated human behaviour and online activity, fed via personal-agent traces and the work-and-economy and communications categories.\n\nBoth meet here as an embedding model that captures the human needs of a population. The supervised trajectory predicts hold-out datasets of sociodemographic characteristics; the unsupervised component reveals hidden dynamics of the macro-space. Over time the system supports personal agents helping users build community and navigate the AI economic transition — answering: 'How can I connect with my neighbors?', 'What economic value can I bring to my community?', and 'How can I effectively advocate for change?'",
  "components": [
    {
      "id": "macro-embedder",
      "name": "Macro-space embedder",
      "role": "Embeds (country, category) pairs into the unsupervised dynamics space.",
      "crate_path": null,
      "key_symbols": [
        "macro_embed"
      ]
    },
    {
      "id": "supervised-trajectory",
      "name": "Supervised trajectory head",
      "role": "Predicts hold-out sociodemographic characteristics from the embedding.",
      "crate_path": null,
      "key_symbols": [
        "holdout_predict"
      ]
    },
    {
      "id": "unsupervised-dynamics",
      "name": "Unsupervised dynamics head",
      "role": "Reveals hidden dynamics of the macro-space (clusters, transitions, attractors).",
      "crate_path": null,
      "key_symbols": [
        "macro_dynamics"
      ]
    },
    {
      "id": "agent-interface",
      "name": "Personal-agent interface",
      "role": "Surfaces relevant slices of the embedding to a user's personal AI agent.",
      "crate_path": null,
      "key_symbols": [
        "agent_query"
      ]
    }
  ],
  "inputs": [
    {
      "name": "country-rollups",
      "kind": "embedding-list",
      "description": "All 257 country-level needs embeddings."
    },
    {
      "name": "category-rollups",
      "kind": "embedding-list",
      "description": "All 15 cross-country category embeddings."
    },
    {
      "name": "holdout-targets",
      "kind": "dataset",
      "description": "Held-out sociodemographic datasets for supervised validation."
    }
  ],
  "outputs": [
    {
      "name": "macro-embedding",
      "kind": "embedding",
      "description": "The 10B human-needs embedding spanning all (country × category) pairs."
    },
    {
      "name": "macro-dynamics",
      "kind": "report",
      "description": "Hidden dynamics of the macro-space — clusters, transitions, attractors."
    },
    {
      "name": "personal-agent-context",
      "kind": "context",
      "description": "Context surfaces for personal agents helping users connect, contribute, and advocate."
    }
  ],
  "parameters": [
    {
      "key": "country-count",
      "value": "257"
    },
    {
      "key": "category-count",
      "value": "15"
    },
    {
      "key": "model-count",
      "value": "4128"
    },
    {
      "key": "design-questions",
      "value": "How can I connect with my neighbors? · What economic value can I bring to my community? · How can I effectively advocate for change?",
      "description": "User-facing questions the system aims to support."
    }
  ],
  "references": [
