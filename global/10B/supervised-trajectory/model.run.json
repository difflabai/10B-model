{
  "modelId": "global.10B.supervised-trajectory",
  "engine": "monte-carlo",
  "inputs": {
    "embedding": {
      "path": "../runs/macro-embedding.json"
    },
    "holdout-targets": {
      "value": [
        "life-expectancy",
        "fertility-rate",
        "internet-penetration",
        "gdp-quintile",
        "gini-quintile"
      ]
    }
  },
  "spec": {
    "inline": {
      "split": [
        0.8,
        0.2
      ],
      "seed": 42,
      "classifier": "logreg",
      "num_samples": 1000
    }
  },
  "output": "../runs/supervised-auc.json"
}
