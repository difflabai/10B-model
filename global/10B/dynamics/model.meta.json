{
  "id": "global.10B.dynamics",
  "name": "10B macro-dynamics — unsupervised cluster discovery",
  "kind": "sector_economic",
  "blurb": "Unsupervised k-means clustering of the country × category needs profile matrix. Reveals hidden dynamics of the macro space: clusters, peer groups, attractors.",
  "mechanism": "Loads the country × category satisfaction matrix produced by `scripts/10b/scorer.py`, performs k-means++ initialised k-means clustering with deterministic seed, and emits cluster assignments, centroids, and per-country nearest-peer lists. The clusters are the unsupervised reveal of macro-space structure called for by the project: which needs profiles repeat across populations, where the attractors sit, and which countries sit at transition boundaries between clusters.",
  "components": [
    {
      "id": "matrix-loader",
      "name": "Country profile matrix loader",
      "role": "Loads scored country profiles.",
      "crate_path": null,
      "key_symbols": []
    },
    {
      "id": "kmeans",
      "name": "k-means++ engine",
      "role": "Deterministic seeded clustering.",
      "crate_path": null,
      "key_symbols": []
    },
    {
      "id": "peers",
      "name": "Peer-distance index",
      "role": "Per-country k-nearest-neighbour lookup over the needs profile.",
      "crate_path": null,
      "key_symbols": []
    },
    {
      "id": "labeler",
      "name": "Cluster labeller",
      "role": "Names each cluster by its dominant strengths and gaps.",
      "crate_path": null,
      "key_symbols": []
    }
  ],
  "inputs": [
    {
      "name": "country-profiles",
      "kind": "matrix",
      "description": "(257 countries × 15 categories) satisfaction matrix."
    }
  ],
  "outputs": [
    {
      "name": "macro-dynamics",
      "kind": "report",
      "description": "Cluster centroids, sizes, labels, and per-country assignments."
    },
    {
      "name": "country-peers",
      "kind": "graph",
      "description": "Per-country nearest-peer lists for personal-agent peer-comparison."
    }
  ],
  "parameters": [
    {
      "key": "country-count",
      "value": "257"
    },
    {
      "key": "category-count",
      "value": "15"
    },
    {
      "key": "k",
      "value": "6",
      "description": "Number of clusters."
    },
    {
      "key": "seed",
      "value": "42",
      "description": "Deterministic seed."
    },
    {
      "key": "init",
      "value": "k-means++"
    },
    {
      "key": "max-iters",
      "value": "60"
    }
  ],
  "references": [
    {
      "label": "MacQueen (1967) — k-means",
      "kind": "paper",
      "location": "macqueen-1967"
    },
    {
      "label": "Arthur & Vassilvitskii (2007) — k-means++",
      "kind": "paper",
      "location": "arthur-vassilvitskii-2007"
    },
    {
      "label": "scripts/10b/dynamics.py",
      "kind": "spec",
      "location": "scripts/10b/dynamics.py"
    }
  ],
