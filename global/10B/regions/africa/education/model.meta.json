{
  "id": "global.10B.regions.africa.education",
  "name": "Africa — Education and learning",
  "kind": "sector_economic",
  "blurb": "Region-level education and learning for Africa, aggregated across 56 countries.",
  "mechanism": "Aggregates the per-country education models for the 56 Africa countries into a single regional category score and a country ranking, feeding both the regional rollup and the cross-country category world rollup.",
