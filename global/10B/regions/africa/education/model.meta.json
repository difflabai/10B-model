    {
      "id": "aggregator",
      "name": "Country aggregator",
      "role": "Region-internal aggregation.",
      "crate_path": null,
      "key_symbols": []
    }
  ],
  "inputs": [
    {
      "name": "education-country-scores",
      "kind": "scalar-list",
      "description": "education scores across Africa countries."
    }
  ],
  "outputs": [
    {
      "name": "education-region-mean",
      "kind": "scalar",
      "description": "Mean education score across the region."
    },
    {
      "name": "education-region-ranking",
      "kind": "ranking",
      "description": "Country-level ranking within the region."
    }
  ],
