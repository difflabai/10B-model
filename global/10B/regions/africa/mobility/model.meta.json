      "role": "Region-internal aggregation.",
      "crate_path": null,
      "key_symbols": []
    }
  ],
  "inputs": [
    {
      "name": "mobility-country-scores",
      "kind": "scalar-list",
      "description": "mobility scores across Africa countries."
    }
  ],
  "outputs": [
