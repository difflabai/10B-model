      "name": "mobility-region-mean",
      "kind": "scalar",
      "description": "Mean mobility score across the region."
    },
    {
      "name": "mobility-region-ranking",
      "kind": "ranking",
      "description": "Country-level ranking within the region."
    }
  ],
