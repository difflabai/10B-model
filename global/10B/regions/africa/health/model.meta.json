{
  "id": "global.10B.regions.africa.health",
  "name": "Africa — Health and longevity",
  "kind": "forecast_harness",
  "blurb": "Region-level health and longevity for Africa, aggregated across 56 countries.",
  "mechanism": "Aggregates the per-country health models for the 56 Africa countries into a single regional category score and a country ranking, feeding both the regional rollup and the cross-country category world rollup.",
  "components": [
    {
      "id": "aggregator",
      "name": "Country aggregator",
      "role": "Region-internal aggregation.",
      "crate_path": null,
      "key_symbols": []
    }
  ],
  "inputs": [
    {
      "name": "health-country-scores",
      "kind": "scalar-list",
      "description": "health scores across Africa countries."
    }
  ],
  "outputs": [
    {
      "name": "health-region-mean",
      "kind": "scalar",
      "description": "Mean health score across the region."
    },
    {
      "name": "health-region-ranking",
      "kind": "ranking",
      "description": "Country-level ranking within the region."
    }
  ],
  "parameters": [
    {
      "key": "region",
      "value": "Africa"
    },
    {
      "key": "category",
      "value": "Health and longevity"
    },
    {
      "key": "country-count",
      "value": "56"
    }
  ],
