{
  "id": "global.10B.regions.africa.work",
  "name": "Africa — Work and economic capability",
  "kind": "forecast_harness",
  "blurb": "Region-level work and economic capability for Africa, aggregated across 56 countries.",
  "mechanism": "Aggregates the per-country work models for the 56 Africa countries into a single regional category score and a country ranking, feeding both the regional rollup and the cross-country category world rollup.",
  "components": [
    {
      "id": "aggregator",
      "name": "Country aggregator",
      "role": "Region-internal aggregation.",
      "crate_path": null,
      "key_symbols": []
    }
  ],
  "inputs": [
    {
      "name": "work-country-scores",
      "kind": "scalar-list",
      "description": "work scores across Africa countries."
    }
  ],
  "outputs": [
    {
      "name": "work-region-mean",
      "kind": "scalar",
      "description": "Mean work score across the region."
    },
    {
      "name": "work-region-ranking",
      "kind": "ranking",
      "description": "Country-level ranking within the region."
    }
  ],
  "parameters": [
    {
      "key": "region",
      "value": "Africa"
    },
    {
      "key": "category",
      "value": "Work and economic capability"
    },
    {
      "key": "country-count",
      "value": "56"
    }
  ],
