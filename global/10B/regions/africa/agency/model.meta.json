  "id": "global.10B.regions.africa.agency",
  "name": "Africa — Agency and self-determination",
  "kind": "sector_economic",
  "blurb": "Region-level agency and self-determination for Africa, aggregated across 56 countries.",
  "mechanism": "Aggregates the per-country agency models for the 56 Africa countries into a single regional category score and a country ranking, feeding both the regional rollup and the cross-country category world rollup.",
