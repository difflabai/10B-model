    {
      "id": "aggregator",
      "name": "Country aggregator",
      "role": "Region-internal aggregation.",
      "crate_path": null,
      "key_symbols": []
    }
  ],
  "inputs": [
    {
      "name": "agency-country-scores",
      "kind": "scalar-list",
      "description": "agency scores across Africa countries."
    }
  ],
  "outputs": [
    {
      "name": "agency-region-mean",
      "kind": "scalar",
      "description": "Mean agency score across the region."
    },
    {
      "name": "agency-region-ranking",
      "kind": "ranking",
      "description": "Country-level ranking within the region."
    }
  ],
