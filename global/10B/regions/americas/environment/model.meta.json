      "role": "Region-internal aggregation.",
      "crate_path": null,
      "key_symbols": []
    }
  ],
  "inputs": [
    {
      "name": "environment-country-scores",
      "kind": "scalar-list",
      "description": "environment scores across Americas countries."
    }
  ],
  "outputs": [
