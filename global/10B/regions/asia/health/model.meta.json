{
  "id": "global.10B.regions.asia.health",
  "name": "Asia — Health and longevity",
  "kind": "forecast_harness",
  "blurb": "Region-level health and longevity for Asia, aggregated across 51 countries.",
  "mechanism": "Aggregates the per-country health models for the 51 Asia countries into a single regional category score and a country ranking, feeding both the regional rollup and the cross-country category world rollup.",
