{
  "id": "global.10B.regions.asia.environment",
  "name": "Asia — Environmental sustainability",
  "kind": "forecast_harness",
  "blurb": "Region-level environmental sustainability for Asia, aggregated across 51 countries.",
  "mechanism": "Aggregates the per-country environment models for the 51 Asia countries into a single regional category score and a country ranking, feeding both the regional rollup and the cross-country category world rollup.",
  "components": [
    {
      "id": "aggregator",
      "name": "Country aggregator",
      "role": "Region-internal aggregation.",
      "crate_path": null,
      "key_symbols": []
    }
  ],
  "inputs": [
    {
      "name": "environment-country-scores",
      "kind": "scalar-list",
      "description": "environment scores across Asia countries."
    }
  ],
  "outputs": [
    {
      "name": "environment-region-mean",
      "kind": "scalar",
      "description": "Mean environment score across the region."
    },
    {
      "name": "environment-region-ranking",
      "kind": "ranking",
      "description": "Country-level ranking within the region."
    }
  ],
  "parameters": [
    {
      "key": "region",
      "value": "Asia"
    },
    {
      "key": "category",
      "value": "Environmental sustainability"
    },
    {
      "key": "country-count",
      "value": "51"
    }
  ],
