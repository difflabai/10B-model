    {
      "id": "aggregator",
      "name": "Country aggregator",
      "role": "Region-internal aggregation.",
      "crate_path": null,
      "key_symbols": []
    }
  ],
  "inputs": [
    {
      "name": "communications-country-scores",
      "kind": "scalar-list",
      "description": "communications scores across Europe countries."
    }
  ],
  "outputs": [
