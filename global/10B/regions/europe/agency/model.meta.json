{
  "id": "global.10B.regions.europe.agency",
  "name": "Europe — Agency and self-determination",
  "kind": "sector_economic",
  "blurb": "Region-level agency and self-determination for Europe, aggregated across 55 countries.",
  "mechanism": "Aggregates the per-country agency models for the 55 Europe countries into a single regional category score and a country ranking, feeding both the regional rollup and the cross-country category world rollup.",
  "components": [
    {
      "id": "aggregator",
      "name": "Country aggregator",
      "role": "Region-internal aggregation.",
      "crate_path": null,
      "key_symbols": []
    }
  ],
  "inputs": [
    {
      "name": "agency-country-scores",
      "kind": "scalar-list",
      "description": "agency scores across Europe countries."
    }
  ],
  "outputs": [
    {
      "name": "agency-region-mean",
      "kind": "scalar",
      "description": "Mean agency score across the region."
    },
    {
      "name": "agency-region-ranking",
      "kind": "ranking",
      "description": "Country-level ranking within the region."
    }
  ],
  "parameters": [
    {
      "key": "region",
      "value": "Europe"
    },
    {
      "key": "category",
      "value": "Agency and self-determination"
    },
