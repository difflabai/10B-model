{
  "id": "global.10B.regions.europe.health",
  "name": "Europe — Health and longevity",
  "kind": "forecast_harness",
  "blurb": "Region-level health and longevity for Europe, aggregated across 55 countries.",
  "mechanism": "Aggregates the per-country health models for the 55 Europe countries into a single regional category score and a country ranking, feeding both the regional rollup and the cross-country category world rollup.",
  "components": [
    {
      "id": "aggregator",
      "name": "Country aggregator",
      "role": "Region-internal aggregation.",
      "crate_path": null,
      "key_symbols": []
    }
  ],
  "inputs": [
    {
      "name": "health-country-scores",
      "kind": "scalar-list",
      "description": "health scores across Europe countries."
    }
  ],
  "outputs": [
    {
      "name": "health-region-mean",
      "kind": "scalar",
      "description": "Mean health score across the region."
    },
    {
      "name": "health-region-ranking",
      "kind": "ranking",
      "description": "Country-level ranking within the region."
    }
  ],
  "parameters": [
    {
      "key": "region",
      "value": "Europe"
    },
    {
      "key": "category",
      "value": "Health and longevity"
    },
    {
      "key": "country-count",
      "value": "55"
    }
  ],
  "references": [
