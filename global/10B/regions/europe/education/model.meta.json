{
  "id": "global.10B.regions.europe.education",
  "name": "Europe — Education and learning",
  "kind": "sector_economic",
  "blurb": "Region-level education and learning for Europe, aggregated across 55 countries.",
  "mechanism": "Aggregates the per-country education models for the 55 Europe countries into a single regional category score and a country ranking, feeding both the regional rollup and the cross-country category world rollup.",
