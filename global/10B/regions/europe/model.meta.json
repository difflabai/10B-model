{
  "id": "global.10B.regions.europe",
  "name": "Europe — needs rollup",
  "kind": "sector_economic",
  "blurb": "Regional rollup for Europe aggregating 55 country needs profiles into a 15-category satisfaction vector.",
  "mechanism": "Aggregates 55 country needs profiles for Europe into a region-level satisfaction vector across all 15 categories. The aggregation is a population-weighted mean (weights from the country's reported population). This sits between the per-country rollups and the global 10B model in the dependency graph.",
