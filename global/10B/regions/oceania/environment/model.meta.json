{
  "id": "global.10B.regions.oceania.environment",
  "name": "Oceania — Environmental sustainability",
  "kind": "forecast_harness",
  "blurb": "Region-level environmental sustainability for Oceania, aggregated across 47 countries.",
  "mechanism": "Aggregates the per-country environment models for the 47 Oceania countries into a single regional category score and a country ranking, feeding both the regional rollup and the cross-country category world rollup.",
