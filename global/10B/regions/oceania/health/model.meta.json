      "crate_path": null,
      "key_symbols": []
    }
  ],
  "inputs": [
    {
      "name": "health-country-scores",
      "kind": "scalar-list",
      "description": "health scores across Oceania countries."
    }
  ],
  "outputs": [
    {
      "name": "health-region-mean",
      "kind": "scalar",
      "description": "Mean health score across the region."
    },
    {
      "name": "health-region-ranking",
      "kind": "ranking",
      "description": "Country-level ranking within the region."
    }
  ],
